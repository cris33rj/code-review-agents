apiVersion: v1
kind: Secret
metadata:
  name: code-review-secrets
  namespace: code-review
type: Opaque
stringData:
  # Add your API keys here (uncomment and fill as needed)
  # IMPORTANT: Never commit this file with real secrets!
  
  # Claude API Key
  CLAUDE_API_KEY: ""
  
  # OpenAI API Key
  OPENAI_API_KEY: ""

---
# NOTE: For production, use external secret management like:
# - Kubernetes External Secrets
# - HashiCorp Vault
# - AWS Secrets Manager
# - Azure Key Vault
#
# Example with External Secrets Operator:
# apiVersion: external-secrets.io/v1beta1
# kind: ExternalSecret
# metadata:
#   name: code-review-secrets
#   namespace: code-review
# spec:
#   secretStoreRef:
#     name: vault-backend
#     kind: SecretStore
#   target:
#     name: code-review-secrets
#   data:
#     - secretKey: CLAUDE_API_KEY
#       remoteRef:
#         key: secret/code-review
#         property: claude_api_key
